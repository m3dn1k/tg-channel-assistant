# Скопируйте в .env и заполните. .env в git не попадает.

# --- Telegram (свои api_id/api_hash: https://my.telegram.org → API development tools) ---
TG_API_ID=
TG_API_HASH=
# @username, https://t.me/username, https://t.me/c/<id>/... или -100<id>
TG_CHANNEL=@example_channel
TG_SESSION=user
SYNC_INTERVAL_SEC=120

# --- Бот (@BotFather). Пусто — только синхронизация ---
BOT_TOKEN=
# Числовые Telegram id через запятую. Остальным бот не отвечает.
ALLOWED_USER_IDS=
ADMIN_IDS=

# --- Хранение ---
# DATA_DIR=./data
# Markdown-копия (например, папка Obsidian). Пусто/off — выключено.
VAULT_PATH=
# Свой системный промпт; по умолчанию prompts/system.md, иначе prompts/system.example.md
PROMPT_FILE=

# --- Ответы ---
HISTORY_TURNS=6
TOP_K=6
MAX_TOKENS=1500
TEMPERATURE=0.5

# --- LLM: gigachat | xai | ollama | deepseek ---
LLM_PROVIDER=ollama

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# GigaChat: ключ авторизации (Basic) из https://developers.sber.ru/studio
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro

# xAI Grok: https://console.x.ai
XAI_API_KEY=
XAI_MODEL=grok-4

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
